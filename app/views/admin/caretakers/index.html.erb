<h1>Caretakers</h1>
<p class="subtitle"><%= @caretakers.size %> total</p>

<%= form_with url: admin_caretakers_path, method: :get, class: "search-row" do %>
  <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search by name or phone…">
  <button type="submit" class="btn btn-outline">Search</button>
<% end %>

<% if @caretakers.any? %>
  <table>
    <thead><tr><th>Name</th><th>Phone</th><th>Joined</th><th></th></tr></thead>
    <tbody>
      <% @caretakers.each do |c| %>
        <tr>
          <td><%= link_to c.full_name, admin_caretaker_path(c) %></td>
          <td><%= c.phone_number %></td>
          <td><%= c.created_at.strftime("%b %d, %Y") %></td>
          <td><%= link_to "View", admin_caretaker_path(c), class: "btn btn-outline btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">No caretakers found.</p>
<% end %>
