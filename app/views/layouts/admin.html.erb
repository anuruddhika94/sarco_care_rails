<!DOCTYPE html>
<html>
  <head>
    <title>SarcoCare Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-param" content="<%= request_forgery_protection_token %>">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <style><%= render "layouts/admin_styles" %></style>
  </head>
  <body>
    <div class="admin-nav">
      <div class="brand">
        <span class="brand-mark"><%= admin_icon(:heart, size: 18) %></span>
        SarcoCare <span class="dot">Admin</span>
      </div>
      <nav>
        <%= link_to admin_root_path, class: ("active" if controller_name == "dashboard") do %>
          <%= admin_icon(:clipboard, size: 16) %> Dashboard
        <% end %>
        <%= link_to admin_patients_path, class: ("active" if controller_name == "patients") do %>
          <%= admin_icon(:heart, size: 16) %> Patients
        <% end %>
        <%= link_to admin_caretakers_path, class: ("active" if controller_name == "caretakers") do %>
          <%= admin_icon(:people, size: 16) %> Caretakers
        <% end %>
        <%= link_to admin_exercises_path, class: ("active" if controller_name == "exercises") do %>
          <%= admin_icon(:dumbbell, size: 16) %> Exercises
        <% end %>
        <%= link_to admin_meal_plan_days_path, class: ("active" if controller_name.start_with?("meal_plan_")) do %>
          <%= admin_icon(:meal, size: 16) %> Meals
        <% end %>
      </nav>
      <div class="who">
        <%= avatar(current_admin.full_name, size: 32) %>
        <span><%= current_admin.full_name %></span>
        <%= button_to "Log out", admin_logout_path, method: :delete, class: "btn btn-outline btn-sm", form: { style: "display:inline" } %>
      </div>
    </div>

    <div class="container">
      <% if notice %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
