<!DOCTYPE html>
<html>
  <head>
    <title>SarcoCare Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-param" content="<%= request_forgery_protection_token %>">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <style><%= render "layouts/admin_styles" %></style>
  </head>
  <body>
    <div class="admin-nav">
      <div class="brand">
        <span class="brand-mark"><%= admin_icon(:heart, size: 18) %></span>
        SarcoCare <span class="dot">Admin</span>
      </div>
      <nav>
        <%= link_to admin_root_path, class: ("active" if controller_name == "dashboard") do %>
          <%= admin_icon(:clipboard, size: 16) %> Dashboard
        <% end %>
        <%= link_to admin_patients_path, class: ("active" if controller_name == "patients") do %>
          <%= admin_icon(:heart, size: 16) %> Patients
        <% end %>
        <%= link_to admin_caretakers_path, class: ("active" if controller_name == "caretakers") do %>
          <%= admin_icon(:people, size: 16) %> Caretakers
        <% end %>
        <%= link_to admin_exercises_path, class: ("active" if controller_name == "exercises") do %>
          <%= admin_icon(:dumbbell, size: 16) %> Exercises
        <% end %>
        <%= link_to admin_meal_plan_days_path, class: ("active" if controller_name.start_with?("meal_plan_")) do %>
          <%= admin_icon(:meal, size: 16) %> Meals
        <% end %>
      </nav>
      <div class="who">
        <%= avatar(current_admin.full_name, size: 32) %>
        <span><%= current_admin.full_name %></span>
        <%= button_to "Log out", admin_logout_path, method: :delete, class: "btn btn-outline btn-sm", form: { style: "display:inline" } %>
      </div>
    </div>

    <div class="container">
      <% if notice %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      <%= yield %>
    </div>
  
<script>
  // The patient page's day pickers swap just their own section in, instead of
  // reloading the whole page. Falls back to normal navigation if anything
  // goes wrong, so the pickers keep working without JavaScript.
  (function () {
    function sectionOf(el) {
      var wrap = el.closest('[data-section]');
      return wrap ? wrap.getAttribute('data-section') : null;
    }

    async function swap(section, url) {
      var wrap = document.querySelector('[data-section="' + section + '"]');
      if (!wrap) { window.location = url; return; }
      wrap.classList.add('is-loading');
      try {
        var sep = url.indexOf('?') === -1 ? '?' : '&';
        var response = await fetch(url + sep + 'section=' + section, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!response.ok) throw new Error(response.status);
        var html = await response.text();
        // Parse rather than assign: development prepends an HTML comment to
        // every rendered partial, and whitespace varies.
        var holder = document.createElement('div');
        holder.innerHTML = html;
        var fresh = holder.querySelector('[data-section="' + section + '"]');
        if (fresh) {
          wrap.replaceWith(fresh);
        } else {
          wrap.outerHTML = html;
        }
        // Keep the address bar honest, so a refresh or a shared link shows
        // the same days.
        window.history.replaceState({}, '', url);
      } catch (e) {
        window.location = url;
      }
    }

    document.addEventListener('change', function (event) {
      var input = event.target;
      if (input.type !== 'date') return;
      var section = sectionOf(input);
      if (!section) return;
      event.preventDefault();
      var form = input.form;
      var params = new URLSearchParams(new FormData(form));
      swap(section, form.action + '?' + params.toString());
    });

    document.addEventListener('click', function (event) {
      var link = event.target.closest('.date-picker a');
      if (!link) return;
      var section = sectionOf(link);
      if (!section) return;
      event.preventDefault();
      swap(section, link.href);
    });
  })();
</script>
</body>
</html>
