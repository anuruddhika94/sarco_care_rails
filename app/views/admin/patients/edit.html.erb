<p class="subtitle"><%= link_to "← #{@patient.full_name}", admin_patient_path(@patient) %></p>
<h1>Edit patient</h1>

<% if @patient.errors.any? %>
  <div class="error-list">
    <% @patient.errors.full_messages.each do |msg| %>
      <div><%= msg %></div>
    <% end %>
  </div>
<% end %>

<%= form_with model: @patient, url: admin_patient_path(@patient), method: :patch do |f| %>
  <div class="field">
    <%= f.label :full_name %>
    <%= f.text_field :full_name %>
  </div>
  <div class="field">
    <%= f.label :phone_number %>
    <%= f.text_field :phone_number %>
  </div>
  <div class="field">
    <%= f.label :email %>
    <%= f.email_field :email %>
  </div>
  <div class="field">
    <%= f.label :gender %>
    <%= f.select :gender, [["Male", "male"], ["Female", "female"], ["Other", "other"]], include_blank: true %>
  </div>
  <div class="field">
    <%= f.label :date_of_birth %>
    <%= f.date_field :date_of_birth %>
  </div>
  <div class="field">
    <%= f.label :password, "New password (leave blank to keep current)" %>
    <%= f.password_field :password, autocomplete: "new-password", minlength: 8 %>
  </div>
  <button type="submit" class="btn btn-primary">Save changes</button>
<% end %>
