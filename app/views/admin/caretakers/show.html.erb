<p class="subtitle"><%= link_to "← All caretakers", admin_caretakers_path %></p>
<h1><%= @caretaker.full_name %></h1>
<p class="subtitle">
  <%= @caretaker.phone_number %>
  <% if @caretaker.email.present? %> · <%= @caretaker.email %><% end %>
</p>

<div class="meta-row">
  <%= link_to "Edit", edit_admin_caretaker_path(@caretaker), class: "btn btn-outline btn-sm" %>
  <%= button_to "Delete account", admin_caretaker_path(@caretaker), method: :delete, class: "btn btn-danger btn-sm",
        form: { onsubmit: "return confirm('Delete #{j @caretaker.full_name}\\'s account? This can\\'t be undone.')", style: "display:inline" } %>
</div>

<div class="section-title">Linked patients</div>
<% if @patients.any? %>
  <table>
    <thead><tr><th>Name</th><th>Relationship</th></tr></thead>
    <tbody>
      <% @patients.each do |link| %>
        <tr>
          <td><%= link_to link.patient.full_name, admin_patient_path(link.patient) %></td>
          <td><%= link.relationship || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">No linked patients.</p>
<% end %>

<div class="section-title">Pending requests sent</div>
<% if @pending_links.any? %>
  <table>
    <thead><tr><th>Patient</th><th>Sent</th></tr></thead>
    <tbody>
      <% @pending_links.each do |link| %>
        <tr>
          <td><%= link.patient.full_name %></td>
          <td><%= link.created_at.strftime("%b %d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">No pending requests.</p>
<% end %>
