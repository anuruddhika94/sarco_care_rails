<p class="subtitle"><%= link_to "← All patients", admin_patients_path %></p>
<div class="profile-header">
  <%= avatar(@patient, size: 56) %>
  <div>
    <h1 style="margin-bottom:2px"><%= @patient.full_name %></h1>
    <p class="subtitle" style="margin:0">
      <%= @patient.phone_number %>
      <% if @patient.email.present? %> · <%= @patient.email %><% end %>
      <% if @patient.age %> · Age <%= @patient.age %><% end %>
      <% if @patient.gender %> · <%= @patient.gender.capitalize %><% end %>
    </p>
  </div>
</div>

<div class="meta-row">
  <%= link_to edit_admin_patient_path(@patient), class: "btn btn-outline btn-sm" do %>
    <%= admin_icon(:person, size: 14) %> Edit
  <% end %>
  <%= button_to admin_patient_path(@patient), method: :delete, class: "btn btn-danger btn-sm",
        form: { onsubmit: "return confirm('Delete #{j @patient.full_name}\\'s account? This can\\'t be undone.')", style: "display:inline" } do %>
    <%= admin_icon(:warning, size: 14) %> Delete account
  <% end %>
</div>

<div class="section-title"><%= admin_icon(:people, size: 16) %> Linked caretakers</div>
<% if @caretakers.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Relationship</th></tr></thead>
      <tbody>
        <% @caretakers.each do |link| %>
          <tr>
            <td>
              <div class="name-cell">
                <%= avatar(link.caretaker, size: 32) %>
                <%= link_to link.caretaker.full_name, admin_caretaker_path(link.caretaker) %>
              </div>
            </td>
            <td><%= link.relationship || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No linked caretakers.</p>
<% end %>

<div class="section-title"><%= admin_icon(:clock, size: 16) %> Activity</div>
<div class="stat-grid">
  <div class="stat-card">
    <div class="top-row"><div class="icon-badge icon-badge-primary"><%= admin_icon(:meal) %></div></div>
    <div>
      <div class="value"><%= @activity_totals[:meals] %></div>
      <div class="label">Meals logged</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="top-row"><div class="icon-badge icon-badge-blue"><%= admin_icon(:dumbbell) %></div></div>
    <div>
      <div class="value"><%= @activity_totals[:exercises] %></div>
      <div class="label">Exercises completed</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="top-row"><div class="icon-badge icon-badge-gold"><%= admin_icon(:clock) %></div></div>
    <div>
      <div class="value"><%= @activity_totals[:minutes] %></div>
      <div class="label">Minutes exercised</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="top-row"><div class="icon-badge icon-badge-primary"><%= admin_icon(:calendar) %></div></div>
    <div>
      <div class="value" style="font-size:22px">
        <%= @activity_totals[:last_seen] ? @activity_totals[:last_seen].strftime("%b %d, %Y") : "—" %>
      </div>
      <div class="label">Last activity</div>
    </div>
  </div>
</div>

<div class="section-title date-bar">
  <span><%= admin_icon(:clipboard, size: 16) %> Daily goals · <%= @goal_date.strftime("%b %d, %Y") %></span>
  <%= render "date_picker", patient: @patient, param: :goal_date, date: @goal_date %>
</div>
<% if @daily_goal %>
  <p class="subtitle">
    Protein <%= @daily_goal.protein_done ? "✓" : "—" %> ·
    exercise <%= @daily_goal.exercise_done ? "✓" : "—" %> ·
    water <%= @daily_goal.water_done ? "✓" : "—" %>
    <span class="badge <%= @daily_goal.score == 100 ? "approved" : (@daily_goal.score.zero? ? "declined" : "pending") %>"><%= @daily_goal.score %>%</span>
  </p>
<% else %>
  <p class="empty">Nothing recorded on this day.</p>
<% end %>

<div class="section-title date-bar">
  <span><%= admin_icon(:meal, size: 16) %> Meals · <%= @meal_date.strftime("%b %d, %Y") %></span>
  <%= render "date_picker", patient: @patient, param: :meal_date, date: @meal_date %>
</div>
<% if @meal_logs.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th></th><th>Meal</th><th>Slot</th><th>Protein</th></tr></thead>
      <tbody>
        <% @meal_logs.each do |log| %>
          <% meal = log.meal_plan_meal %>
          <tr>
            <td><%= meal_thumbnail(meal, size: 40) %></td>
            <td>
              <div style="font-weight:700"><%= meal.title_en %></div>
              <div style="color:var(--text-muted);font-size:13px"><%= meal.title_th %></div>
            </td>
            <td><span class="badge approved"><%= meal.slot.humanize %></span></td>
            <td><%= meal.total_protein_en %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No meals logged on this day.</p>
<% end %>

<div class="section-title date-bar">
  <span><%= admin_icon(:dumbbell, size: 16) %> Exercises · <%= @exercise_date.strftime("%b %d, %Y") %></span>
  <%= render "date_picker", patient: @patient, param: :exercise_date, date: @exercise_date %>
</div>
<% if @exercise_logs.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th></th><th>Exercise</th><th>Minutes</th></tr></thead>
      <tbody>
        <% @exercise_logs.each do |log| %>
          <tr>
            <td>
              <% if log.exercise.thumbnail_url.present? %>
                <img src="<%= log.exercise.thumbnail_url %>" style="width:32px;height:44px;border-radius:6px;object-fit:contain;background:var(--border);display:block">
              <% end %>
            </td>
            <td>
              <div style="font-weight:700"><%= log.exercise.name_en %></div>
              <div style="color:var(--text-muted);font-size:13px"><%= log.exercise.name_th %></div>
            </td>
            <td><%= log.minutes %> min</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No exercises completed on this day.</p>
<% end %>

<div class="section-title date-bar">
  <span><%= admin_icon(:heart, size: 16) %> Health readings · <%= @health_date.strftime("%b %d, %Y") %></span>
  <%= render "date_picker", patient: @patient, param: :health_date, date: @health_date %>
</div>
<% if @health_readings.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Weight</th><th>Height</th><th>BMI</th><th>Calf</th></tr></thead>
      <tbody>
        <% @health_readings.each do |r| %>
          <tr>
            <td><%= r.weight_kg ? "#{r.weight_kg} kg" : "—" %></td>
            <td><%= r.height_cm ? "#{r.height_cm} cm" : "—" %></td>
            <td><%= r.bmi || "—" %></td>
            <td><%= r.calf_cm ? "#{r.calf_cm} cm" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">Nothing recorded on this day.</p>
<% end %>

<div class="section-title"><%= admin_icon(:clipboard, size: 16) %> Recent SARC-F assessments</div>
<% if @assessments.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Date</th><th>Score</th><th>Risk</th></tr></thead>
      <tbody>
        <% @assessments.each do |a| %>
          <tr>
            <td><%= a.completed_at.strftime("%b %d, %Y") %></td>
            <td><%= a.score %></td>
            <td><span class="badge <%= a.risk_level == 'low' ? 'approved' : (a.risk_level == 'high' ? 'declined' : 'pending') %>"><%= a.risk_level %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No assessments completed.</p>
<% end %>
