<p class="subtitle"><%= link_to "← All days", admin_meal_plan_days_path %></p>
<h1>Day <%= @day.day_number %></h1>

<% if @day.errors.any? %>
  <div class="error-list">
    <% @day.errors.full_messages.each do |msg| %>
      <div><%= msg %></div>
    <% end %>
  </div>
<% end %>

<div class="card">
  <%= form_with model: @day, url: admin_meal_plan_day_path(@day), method: :patch do |f| %>
    <div class="field">
      <%= f.label :label_en, "Label (English)" %>
      <%= f.text_field :label_en %>
    </div>
    <div class="field">
      <%= f.label :label_th, "Label (Thai)" %>
      <%= f.text_field :label_th %>
    </div>
    <div class="field">
      <%= f.label :day_total_en, "Day total (English)" %>
      <%= f.text_field :day_total_en, placeholder: "e.g. ~65g protein · 3 meals" %>
    </div>
    <div class="field">
      <%= f.label :day_total_th, "Day total (Thai)" %>
      <%= f.text_field :day_total_th %>
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
  <% end %>
</div>

<div class="meta-row" style="justify-content: space-between;">
  <h2 style="margin:0">Meals</h2>
  <%= link_to new_admin_meal_plan_day_meal_plan_meal_path(@day), class: "btn btn-primary btn-sm" do %>
    <%= admin_icon(:meal, size: 14) %> Add meal
  <% end %>
</div>

<% if @day.meal_plan_meals.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Slot</th><th>Title</th><th>Protein</th><th>Items</th><th></th></tr></thead>
      <tbody>
        <% @day.meal_plan_meals.order(:position).each do |meal| %>
          <tr>
            <td><span class="badge approved"><%= meal.slot.humanize %></span></td>
            <td>
              <div style="font-weight:700"><%= meal.title_en %></div>
              <div style="color:var(--text-muted);font-size:13px"><%= meal.title_th %></div>
            </td>
            <td><%= meal.total_protein_en %></td>
            <td><%= meal.meal_plan_items.size %></td>
            <td style="white-space:nowrap">
              <%= link_to "Edit", edit_admin_meal_plan_day_meal_plan_meal_path(@day, meal), class: "btn btn-outline btn-sm" %>
              <%= button_to "Delete", admin_meal_plan_day_meal_plan_meal_path(@day, meal), method: :delete, class: "btn btn-danger btn-sm",
                    form: { onsubmit: "return confirm('Remove #{j meal.title_en}? Patients will no longer see it.')", style: "display:inline" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty">No meals yet for this day.</p>
<% end %>
