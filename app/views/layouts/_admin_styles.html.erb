:root {
  --primary: #3b8b5f;
  --primary-dark: #2e6b49;
  --bg: #faf6ec;
  --surface: #ffffff;
  --border: #eaefea;
  --text: #2b3a2f;
  --text-muted: #6b7b70;
  --danger: #b0524b;
  --blue: #3e7cb1;
  --gold: #cb8a2e;
  --purple: #8b5fbf;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
}
a { color: var(--primary); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ---------- Nav ---------- */
.admin-nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 24px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
}
.admin-nav .brand { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 18px; color: var(--text); }
.admin-nav .brand .dot { color: var(--primary); }
.admin-nav .brand-mark {
  width: 32px; height: 32px; border-radius: 9px; background: var(--primary);
  color: white; display: flex; align-items: center; justify-content: center;
}
.admin-nav nav { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
.admin-nav nav a { display: flex; align-items: center; gap: 6px; color: var(--text-muted); font-weight: 600; font-size: 14px; padding: 8px 12px; border-radius: 8px; }
.admin-nav nav a:hover { background: var(--bg); text-decoration: none; }
.admin-nav nav a.active { color: var(--primary); background: #e4efe7; }
.admin-nav .who { display: flex; gap: 12px; align-items: center; font-size: 14px; color: var(--text-muted); }

.container { max-width: 1080px; margin: 0 auto; padding: 28px 24px 60px; }

.flash { padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; }
.flash.notice { background: #e4efe7; color: var(--primary-dark); }
.flash.alert { background: #fbe9e7; color: var(--danger); }

h1 { font-size: 26px; font-weight: 800; margin: 0 0 4px; }
h2 { font-size: 18px; font-weight: 800; margin: 0 0 12px; }
.subtitle { color: var(--text-muted); font-size: 14px; margin: 0 0 24px; }

/* ---------- Avatars & icon badges ---------- */
.avatar {
  border-radius: 999px; color: white; font-weight: 800;
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.avatar-a { background: var(--primary); }
.avatar-b { background: var(--blue); }
.avatar-c { background: var(--danger); }
.avatar-d { background: var(--gold); }
.avatar-e { background: var(--purple); }

.icon-badge {
  border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.icon-badge-primary { background: rgba(59, 139, 95, 0.12); color: var(--primary); }
.icon-badge-blue { background: rgba(62, 124, 177, 0.12); color: var(--blue); }
.icon-badge-gold { background: rgba(203, 138, 46, 0.12); color: var(--gold); }
.icon-badge-danger { background: rgba(176, 82, 75, 0.12); color: var(--danger); }
.icon-badge-purple { background: rgba(139, 95, 191, 0.12); color: var(--purple); }

.name-cell { display: flex; align-items: center; gap: 12px; }
.profile-header { display: flex; align-items: center; gap: 16px; margin-bottom: 4px; }

/* ---------- Stat cards ---------- */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px; }
.stat-card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 20px;
  display: flex; flex-direction: column; gap: 14px;
}
.stat-card .top-row { display: flex; align-items: center; justify-content: space-between; }
.stat-card .value { font-size: 34px; font-weight: 800; color: var(--text); line-height: 1; }
.stat-card .label { font-size: 14px; color: var(--text-muted); margin-top: 4px; }

/* ---------- Simple CSS bar chart (role split) ---------- */
.bar-chart { display: flex; height: 14px; border-radius: 999px; overflow: hidden; background: var(--border); }
.bar-chart .seg { height: 100%; }
.bar-chart .seg.patients { background: var(--primary); }
.bar-chart .seg.caretakers { background: var(--blue); }
.legend { display: flex; gap: 20px; margin-top: 10px; font-size: 13px; color: var(--text-muted); }
.legend .dot { width: 10px; height: 10px; border-radius: 999px; display: inline-block; margin-right: 6px; }

.card {
  background: var(--surface); border: 1px solid var(--border); border-radius: 18px;
  padding: 22px; margin-bottom: 20px;
}
.card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
.card-header h2 { margin: 0; }

/* ---------- Tables ---------- */
.table-wrap { overflow-x: auto; border-radius: 16px; border: 1px solid var(--border); background: var(--surface); }
table { width: 100%; min-width: 480px; border-collapse: collapse; }
th, td { text-align: left; padding: 14px 16px; font-size: 14px; border-bottom: 1px solid var(--border); white-space: nowrap; }
th { color: var(--text-muted); font-weight: 700; background: #fbfbf8; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; }
tr:last-child td { border-bottom: none; }
tr:hover td { background: #fbfbf8; }

.badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; }
.badge.pending { background: #fdf3d8; color: #a3711e; }
.badge.approved { background: #e4efe7; color: var(--primary-dark); }
.badge.declined { background: #fbe9e7; color: var(--danger); }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  padding: 12px 20px; border-radius: 10px; font-size: 15px; font-weight: 700;
  border: 1px solid transparent; cursor: pointer; text-decoration: none;
  min-height: 44px; /* touch target */
}
.btn:hover { text-decoration: none; }
.btn-primary { background: var(--primary); color: white; }
.btn-primary:hover { background: var(--primary-dark); }
.btn-outline { background: transparent; border-color: var(--primary); color: var(--primary); }
.btn-danger { background: transparent; border-color: var(--danger); color: var(--danger); }
.btn-sm { padding: 8px 14px; font-size: 13px; min-height: 36px; }

.search-row { display: flex; gap: 10px; margin-bottom: 20px; }
.search-row input[type="text"] { flex: 1; }

input[type="text"], input[type="email"], input[type="password"], input[type="date"], select {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #dde4dd;
  border-radius: 10px;
  font-size: 15px;
  background: white;
  color: var(--text);
  min-height: 44px;
}
input:focus, select:focus { outline: none; border-color: var(--primary); }
label { display: block; font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 6px; }
.field { margin-bottom: 16px; }
.error-list { background: #fbe9e7; color: var(--danger); padding: 12px 16px; border-radius: 10px; font-size: 14px; margin-bottom: 16px; }

.auth-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; background: linear-gradient(160deg, var(--bg) 0%, #f0ecdd 100%); }
.auth-card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 36px; width: 100%; max-width: 380px; box-shadow: 0 20px 40px rgba(43, 58, 47, 0.06); }
.auth-card .brand-mark { width: 48px; height: 48px; border-radius: 14px; margin: 0 auto 16px; font-size: 22px; }
.auth-card h1 { text-align: center; }
.auth-card .subtitle { text-align: center; }

.section-title { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; color: var(--text-muted); margin: 28px 0 12px; text-transform: uppercase; letter-spacing: 0.03em; }
.empty { color: var(--text-muted); font-size: 14px; padding: 20px; text-align: center; background: var(--surface); border: 1px dashed var(--border); border-radius: 14px; }
.meta-row { display: flex; gap: 8px; align-items: center; margin-top: 16px; flex-wrap: wrap; }

/* ---------- Responsive: tablets (iPad) and phones ---------- */
@media (max-width: 900px) {
  .container { padding: 20px 16px 48px; }
  .admin-nav { padding: 12px 16px; }
  .stat-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .admin-nav { flex-direction: column; align-items: stretch; }
  .admin-nav nav { justify-content: space-between; }
  .admin-nav .who { justify-content: space-between; }
  .stat-grid { grid-template-columns: 1fr; }
  h1 { font-size: 22px; }
  .search-row { flex-direction: column; }
}
